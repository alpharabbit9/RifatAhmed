# Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the client.
# Used only by scripts/create-admin-user.ts to provision the single admin user.
SUPABASE_SERVICE_ROLE_KEY=

# Credentials for the one admin user, used only by scripts/create-admin-user.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canonical origin, used for metadataBase, Open Graph image URLs, canonical
# links, robots.txt and sitemap.xml (see lib/site.ts).
#
# Leave blank locally — it falls back to http://localhost:3000, and on Vercel
# to the deployment host. Set it in the Vercel project once a real domain is
# attached, e.g. https://rifatahmed.com
NEXT_PUBLIC_SITE_URL=
